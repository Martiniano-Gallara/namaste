# ==========================================
# NAMASTÉ — Variables de Entorno (Vercel & Supabase)
# ==========================================

# 1. Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# 2. Credenciales de la API de Supabase
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# 3. Pasarela de Cobros Mercado Pago (Para producción)
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# 4. Seguridad de Administración & Acceso (IMPORTANTE: Generar claves seguras únicas)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_in_production
ADMIN_SECRET=generate_a_random_secure_secret_here

# 5. Configuración de CORS (Opcional, separados por comas)
# CORS_ALLOWED_ORIGINS=https://namasteyoga.com.ar,https://www.namasteyoga.com.ar
